datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum ImageAssetType {
  PROFILE
  BODY_PROFILE
  CLOSET_ITEM
  OUTFIT_RESULT
}

enum ImageAssetOrigin {
  USER_UPLOAD
  GENERATED
  FALLBACK
}

enum ImageAssetStatus {
  UPLOADING
  ACTIVE
  UPLOAD_FAILED
  DELETE_PENDING
  DELETE_FAILED
  DELETED
}

enum OutfitGenerationStatus {
  QUEUED
  PROCESSING
  QC_PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// 예시 user테이블. 나중에 ERD보면서 수정하면 됩니다.
model User {
  id                   Int                   @id @default(autoincrement())
  username             String?               @unique @db.VarChar(30)
  email                String                @unique
  passwordHash         String?               @map("password_hash") @db.VarChar(60)
  name                 String?
  profileImageUrl      String?               @map("profile_image_url") @db.VarChar(1000)
  styleTags            Json?                 @map("style_tags")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?             @map("deleted_at")
  images               ImageAsset[]
  closetItems          ClosetItem[]
  consentLogs          ConsentLog[]
  importSessions       ImportSession[]
  outfitGenerationJobs OutfitGenerationJob[]
  outfitResults        OutfitResult[]
  savedOutfits         SavedOutfit[]
  outfitRevisions      OutfitRevision[]
  userSelectedBodyType   String?   @map("selected_body_type") @db.VarChar(60)
  bodyProfile          BodyProfile?
  stylePreferences     UserStylePreference[]
  bodyAnalysisSessions BodyAnalysisSession[]
  puzzleWallet         PuzzleWallet?
  puzzleTransactions   PuzzleTransaction[]

  @@map("users")
}

enum PuzzleTransactionType {
  CREDIT
  DEBIT
}

model PuzzleWallet {
  userId    Int      @id @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("puzzle_wallets")
}

model PuzzleTransaction {
  id             Int                   @id @default(autoincrement())
  userId         Int                   @map("user_id")
  type           PuzzleTransactionType
  amount         Int
  balanceAfter   Int                   @map("balance_after")
  reason         String                @db.VarChar(80)
  idempotencyKey String                @map("idempotency_key") @db.VarChar(128)
  referenceType  String?               @map("reference_type") @db.VarChar(40)
  referenceId    String?               @map("reference_id") @db.VarChar(80)
  createdAt      DateTime              @default(now()) @map("created_at")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("puzzle_transactions")
}

model StyleTag {
  id           Int                   @id
  code         String                @unique @db.VarChar(30)
  name         String                @unique @db.VarChar(50)
  displayOrder Int                   @unique @map("display_order")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  preferences  UserStylePreference[]

  @@map("style_tags")
}

model UserStylePreference {
  userId     Int      @map("user_id")
  styleTagId Int      @map("style_tag_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  styleTag   StyleTag @relation(fields: [styleTagId], references: [id], onDelete: Restrict)

  @@id([userId, styleTagId])
  @@index([styleTagId])
  @@map("user_style_preferences")
}

model OutfitGenerationJob {
  id                 Int                    @id @default(autoincrement())
  userId             Int                    @map("user_id")
  idempotencyKey     String?                @map("idempotency_key") @db.VarChar(128)
  inputSchemaVersion String                 @default("outfit-input-v1") @map("input_schema_version") @db.VarChar(40)
  status             OutfitGenerationStatus @default(QUEUED)
  bodyProfileId      Int?                   @map("body_profile_id")
  closetItemIds      Json                   @map("closet_item_ids")
  styleTagIds        Json                   @map("style_tag_ids")
  situation          String?                @db.VarChar(30)
  selectedDate       DateTime?              @map("selected_date") @db.Date
  weather            Json?
  inputSnapshot      Json?                  @map("input_snapshot")
  progress           Int                    @default(5)
  expiresAt          DateTime               @map("expires_at")
  failureCode        String?                @map("failure_code") @db.VarChar(80)
  failureReason      String?                @map("failure_reason") @db.VarChar(500)
  startedAt          DateTime?              @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  bodyProfile        BodyProfile?           @relation(fields: [bodyProfileId], references: [id], onDelete: SetNull)
  result             OutfitResult?
  revision           OutfitRevision?

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@map("outfit_generation_jobs")
}

model BodyAnalysisSession {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  resultData  Json     @map("result_data")  // Gemini가 뱉어낸 분석 결과 JSON 전체
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("body_analysis_sessions")
}

model BodyProfile {
  id                   Int                   @id @default(autoincrement())
  userId               Int                   @unique @map("user_id")
  bodyType             String?               @map("body_type")
  bodyBalance          BodyBalance?          @map("body_balance")
  shoulderWidth        ShoulderWidth?        @map("shoulder_width")
  frameSize            FrameSize?            @map("frame_size")
  analysisId           Int?                  @map("analysis_id")
  shoulderWidthCm      Float?                @map("shoulder_width_cm") // 숫자 치수 저장용
  chestCircumference   Float?                @map("chest_circumference")
  waistCircumference   Float?                @map("waist_circumference")
  hipCircumference     Float?                @map("hip_circumference")
  upperBodyLength      Float?                @map("upper_body_length")
  lowerBodyLength      Float?                @map("lower_body_length")
  legLength            Float?                @map("leg_length")
  upperBodyRatio       Int?                  @map("upper_body_ratio")
  lowerBodyRatio       Int?                  @map("lower_body_ratio")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  outfitGenerationJobs OutfitGenerationJob[]

  @@map("body_profiles")
}

enum BodyBalance {
  UPPER_BODY_DEVELOPED
  BALANCED
  LOWER_BODY_DEVELOPED
}

enum ShoulderWidth {
  NARROW
  AVERAGE
  WIDE
}

enum FrameSize {
  SMALL
  MEDIUM
  LARGE
}

model OutfitResult {
  id                       Int                 @id @default(autoincrement())
  userId                   Int                 @map("user_id")
  generationJobId          Int                 @unique @map("generation_job_id")
  generatedImageUrl        String              @map("generated_image_url") @db.VarChar(1000)
  provider                 String              @db.VarChar(80)
  modelVersion             String              @default("legacy") @map("model_version") @db.VarChar(80)
  promptVersion            String?             @map("prompt_version") @db.VarChar(80)
  fallbackUsed             Boolean             @default(false) @map("fallback_used")
  outfitItems              Json?               @map("outfit_items")
  recommendedClosetItemIds Json                @map("recommended_closet_item_ids")
  createdAt                DateTime            @default(now()) @map("created_at")
  user                     User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  generationJob            OutfitGenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Restrict)
  savedOutfits             SavedOutfit[]
  sourceRevisions          OutfitRevision[]    @relation("RevisionSource")

  @@index([userId, createdAt])
  @@map("outfit_results")
}

model SavedOutfit {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  outfitResultId Int          @map("outfit_result_id")
  name           String       @db.VarChar(120)
  tags           Json
  memo           String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  outfitResult   OutfitResult @relation(fields: [outfitResultId], references: [id], onDelete: Restrict)

  @@unique([userId, outfitResultId])
  @@index([userId, createdAt])
  @@index([userId, deletedAt])
  @@map("saved_outfits")
}

model OutfitRevision {
  id                   Int                 @id @default(autoincrement())
  userId               Int                 @map("user_id")
  sourceOutfitResultId Int                 @map("source_outfit_result_id")
  replaceItemId        Int                 @map("replace_item_id")
  newItemId            Int                 @map("new_item_id")
  generationJobId      Int                 @unique @map("generation_job_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceOutfitResult   OutfitResult        @relation("RevisionSource", fields: [sourceOutfitResultId], references: [id], onDelete: Restrict)
  generationJob        OutfitGenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("outfit_revisions")
}

model ImageAsset {
  id               Int              @id @default(autoincrement())
  userId           Int              @map("user_id")
  imageType        ImageAssetType   @map("image_type")
  origin           ImageAssetOrigin @default(USER_UPLOAD)
  storageProvider  String           @map("storage_provider") @db.VarChar(40)
  storageKey       String           @unique @map("storage_key") @db.VarChar(500)
  originalFileName String?          @map("original_file_name") @db.VarChar(255)
  mimeType         String           @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int              @map("file_size_bytes")
  checksumSha256   String           @map("checksum_sha256") @db.Char(64)
  status           ImageAssetStatus @default(UPLOADING)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  closetItems      ClosetItem[]

  @@index([userId, status])
  @@map("image_assets")
}

model ClosetItem {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  imageId    Int?        @map("image_id")
  name       String     @db.VarChar(120)
  brand       String?   @db.VarChar(100)
  colorText   String?   @map("color_text") @db.VarChar(50)
  colorHex    String?   @map("color_hex") @db.VarChar(7)
  subCategory String?   @map("sub_category") @db.VarChar(60)
  memo        String?   @db.VarChar(500)
  category   String     @db.VarChar(60)
  importType String     @map("import_type") @db.VarChar(60)
  deletedAt  DateTime?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  imageAsset ImageAsset? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  tags       ItemTag[]

  @@index([userId, createdAt])
  @@index([imageId])
  @@map("closet_items")
}

model ItemTag {
  id           Int        @id @default(autoincrement())
  closetItemId Int        @map("closet_item_id")
  tagName      String     @map("tag_name") @db.VarChar(60)
  closetItem   ClosetItem @relation(fields: [closetItemId], references: [id], onDelete: Cascade)

  @@unique([closetItemId, tagName])
  @@map("item_tags")
}

model ShoppingPlatform {
  id             Int             @id @default(autoincrement())
  platformName   String          @unique @map("platform_name") @db.VarChar(60)
  importSessions ImportSession[]

  @@map("shopping_platforms")
}

model ImportSession {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  platformId Int              @map("platform_id")
  status     String           @db.VarChar(30)
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  platform   ShoppingPlatform @relation(fields: [platformId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("import_sessions")
}

model ConsentLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  target    String   @db.VarChar(60)
  isAgreed  Boolean  @map("is_agreed")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("consent_logs")
}
