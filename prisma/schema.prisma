datasource db {
  provider = "mysql"
//  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 예시 user테이블. 나중에 ERD보면서 수정하면 됩니다.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}