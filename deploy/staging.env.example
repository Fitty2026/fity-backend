# 서버에서 .env로 복사한 뒤 모든 change-me 값을 교체합니다.
MYSQL_DATABASE=fitty
MYSQL_USER=fitty
MYSQL_PASSWORD=change-me-url-safe-database-password
MYSQL_ROOT_PASSWORD=change-me-url-safe-root-password
DATABASE_URL=mysql://fitty:change-me-url-safe-database-password@db:3306/fitty

JWT_ACCESS_SECRET=change-me-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=7d
INTERNAL_WORKER_TOKEN=change-me-long-worker-token

AI_OUTFIT_ADAPTER_URL=
AI_OUTFIT_ADAPTER_TIMEOUT_MS=10000
FALLBACK_OUTFIT_IMAGE_URL=/fallback/default-outfit.png
CORS_ALLOWED_ORIGINS=

IMAGE_REPOSITORY=ghcr.io/fitty2026/fity-backend
IMAGE_REF=ghcr.io/fitty2026/fity-backend@sha256:change-me
APP_VERSION=unknown
FRONTEND_COMMIT_SHA=unknown
SHUTDOWN_TIMEOUT_MS=10000
EXTERNAL_HEALTH_URL=https://fitty.gubiko.dev/health
EXTERNAL_HEALTH_REQUIRED=false

# Cloudflare Access 적용 후 자동 health 확인에만 사용합니다.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
