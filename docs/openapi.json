{
  "openapi": "3.1.0",
  "info": {
    "title": "Fitty BE4 Outfit API",
    "version": "1.0.0",
    "description": "Outfit generation job and saved outfit contract. The API enqueues jobs; a DB polling worker performs generation work."
  },
  "servers": [
    { "url": "/api/v1" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/outfits/generation-jobs": {
      "post": {
        "operationId": "createOutfitGenerationJob",
        "summary": "Create or resume a base-item outfit recommendation and generation job",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateGenerationJobRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/outfits/generation-jobs/active": {
      "get": {
        "operationId": "getActiveOutfitGenerationJob",
        "summary": "Get the authenticated user's active job",
        "responses": { "200": { "$ref": "#/components/responses/JobResponse" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/generation-jobs/{jobId}": {
      "get": {
        "operationId": "getOutfitGenerationJob",
        "summary": "Poll an outfit generation job",
        "parameters": [ { "$ref": "#/components/parameters/JobId" } ],
        "responses": { "200": { "$ref": "#/components/responses/JobResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/{outfitResultId}/revisions": {
      "post": {
        "operationId": "createOutfitRevision",
        "summary": "Replace a same-category item and enqueue regeneration",
        "parameters": [ { "$ref": "#/components/parameters/OutfitResultId" }, { "$ref": "#/components/parameters/IdempotencyKey" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRevisionRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/JobResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/saved": {
      "post": {
        "operationId": "saveOutfit",
        "summary": "Save a completed outfit result",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaveOutfitRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      },
      "get": {
        "operationId": "listSavedOutfits",
        "summary": "List saved outfits",
        "parameters": [ { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Size" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/saved/deleted": {
      "get": {
        "operationId": "listDeletedSavedOutfits",
        "summary": "List soft-deleted saved outfits",
        "parameters": [ { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Size" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/saved/{savedOutfitId}": {
      "get": {
        "operationId": "getSavedOutfit",
        "summary": "Get a saved outfit",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "patch": {
        "operationId": "updateSavedOutfit",
        "summary": "Update saved outfit metadata",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateSavedOutfitRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "softDeleteSavedOutfit",
        "summary": "Soft delete a saved outfit",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/saved/{savedOutfitId}/restore": {
      "post": {
        "operationId": "restoreSavedOutfit",
        "summary": "Restore a soft-deleted saved outfit",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/saved/{savedOutfitId}/likes": {
      "post": {
        "operationId": "likeSavedOutfit",
        "summary": "Like a saved outfit",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "unlikeSavedOutfit",
        "summary": "Remove a like from a saved outfit",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/outfits/saved/{savedOutfitId}/permanent": {
      "delete": {
        "operationId": "permanentlyDeleteSavedOutfit",
        "summary": "Permanently delete a soft-deleted saved outfit",
        "parameters": [ { "$ref": "#/components/parameters/SavedOutfitId" } ],
        "responses": { "200": { "$ref": "#/components/responses/SavedOutfitResponse" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/puzzles/balance": {
      "get": {
        "operationId": "getPuzzleBalance",
        "summary": "Get the authenticated user's puzzle balance",
        "responses": {
          "200": { "$ref": "#/components/responses/PuzzleBalanceResponse" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 100 } },
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "OutfitResultId": { "name": "outfitResultId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "SavedOutfitId": { "name": "savedOutfitId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "Page": { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "Size": { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } }
    },
    "schemas": {
      "CreateGenerationJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "closetItemIds" ],
        "properties": {
          "closetItemIds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "description": "Send one base closet item. The server completes TOP/BOTTOM/SHOES from the authenticated user's closet and stores the final three IDs. Up to three IDs remain accepted for legacy clients.", "items": { "type": "integer", "minimum": 1 } },
          "styleTagIds": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 }, "description": "Omit to use stored preferences." },
          "situation": { "type": [ "string", "null" ], "enum": [ "DATE", "WORK", "SCHOOL", "TRAVEL", null ] },
          "selectedDate": { "type": [ "string", "null" ], "format": "date" },
          "weather": { "$ref": "#/components/schemas/Weather" }
        }
      },
      "Weather": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [ "condition" ],
            "properties": {
              "condition": { "type": "string", "enum": [ "SUNNY", "CLOUDY", "RAINY", "SNOWY", "WINDY", "UNKNOWN" ] },
              "temperature": { "type": "number" }
            }
          }
        ]
      },
      "CreateRevisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "replaceItemId", "newItemId" ],
        "properties": { "replaceItemId": { "type": "integer", "minimum": 1 }, "newItemId": { "type": "integer", "minimum": 1 } }
      },
      "SaveOutfitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "outfitResultId" ],
        "properties": {
          "outfitResultId": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "maxLength": 20 },
          "tags": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "memo": { "type": "string", "maxLength": 200 }
        }
      },
      "UpdateSavedOutfitRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "outfitResultId": { "type": "integer", "minimum": 1, "description": "Replacement result created by an item-change revision." },
          "name": { "type": "string", "maxLength": 20 },
          "tags": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "memo": { "type": "string", "maxLength": 200 }
        }
      },
      "OutfitItem": {
        "type": "object",
        "required": [ "slot", "itemId" ],
        "properties": { "slot": { "type": "string", "minLength": 1 }, "itemId": { "type": "integer", "minimum": 1 } }
      },
      "Job": {
        "type": [ "object", "null" ],
        "properties": {
          "jobId": { "type": "integer" },
          "status": { "type": "string", "enum": [ "queued", "processing", "qc_pending", "completed", "failed", "expired" ] },
          "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
          "inputSchemaVersion": { "type": "string" },
          "isExistingJob": { "type": "boolean" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "outfitResultId": { "type": [ "integer", "null" ] },
          "generatedImageUrl": { "type": [ "string", "null" ], "description": "Compatibility alias of generatedImage.imageUrl." },
          "generatedImage": { "type": [ "object", "null" ] },
          "failure": { "type": [ "object", "null" ] }
        }
      },
      "SavedOutfit": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "savedOutfitId": { "type": "integer" },
          "outfitResultId": { "type": "integer" },
          "name": { "type": "string" },
          "imageUrl": { "type": "string" },
          "modelVersion": { "type": "string" },
          "promptVersion": { "type": [ "string", "null" ] },
          "items": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "integer" }, "itemId": { "type": "integer" }, "name": { "type": "string" }, "brand": { "type": [ "string", "null" ] }, "category": { "type": [ "string", "null" ] }, "colorText": { "type": [ "string", "null" ] }, "colorHex": { "type": [ "string", "null" ] }, "imageUrl": { "type": [ "string", "null" ] } } } },
          "itemIds": { "type": "array", "items": { "type": "integer" } },
          "outfitItems": { "type": [ "array", "null" ], "items": { "$ref": "#/components/schemas/OutfitItem" } },
          "styleTags": { "type": "array", "items": { "type": "integer" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "memo": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": [ "string", "null" ], "format": "date-time" },
          "deletionDaysRemaining": { "type": "integer", "minimum": 0, "maximum": 30 },
          "isSaved": { "type": "boolean" },
          "isLiked": { "type": "boolean", "description": "Whether the authenticated user has liked this saved outfit." }
        }
      },
      "PuzzleBalance": {
        "type": "object",
        "required": [ "balance", "currency" ],
        "properties": {
          "balance": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string", "const": "PUZZLE" }
        }
      },
      "Envelope": {
        "type": "object",
        "required": [ "isSuccess", "code", "message", "result" ],
        "properties": {
          "isSuccess": { "type": "boolean" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "result": {}
        }
      }
    },
    "responses": {
      "JobResponse": { "description": "Common response containing a job or null", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "SavedOutfitResponse": { "description": "Common response containing saved outfit data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "PuzzleBalanceResponse": { "description": "Common response containing the puzzle balance", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Error": { "description": "Common error response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
    }
  }
}
